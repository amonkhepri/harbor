<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:paddingStart="@dimen/margin_activity_horizontal"
	android:paddingTop="@dimen/margin_medium"
	android:paddingEnd="@dimen/margin_activity_horizontal"
	android:paddingBottom="@dimen/margin_medium">

	<LinearLayout
		android:id="@+id/connectorFileLayout"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:visibility="gone">

		<ImageView
			android:id="@+id/connectorFileIcon"
			android:layout_width="32dp"
			android:layout_height="32dp"
			android:layout_marginEnd="@dimen/margin_small"
			android:contentDescription="@null"
			android:src="@drawable/ic_file" />

		<LinearLayout
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:orientation="vertical">

			<TextView
				android:id="@+id/connectorFileName"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:ellipsize="middle"
				android:maxLines="1"
				android:textColor="?android:attr/textColorPrimary"
				android:textSize="@dimen/text_size_medium" />

			<TextView
				android:id="@+id/connectorFileDetails"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:textColor="?android:attr/textColorSecondary"
				android:textSize="@dimen/text_size_small" />

		</LinearLayout>

	</LinearLayout>

	<TextView
		android:id="@+id/connectorMessageText"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:textColor="?android:attr/textColorPrimary"
		android:textSize="@dimen/text_size_medium" />

	<ImageView
		android:id="@+id/connectorMessageThumbnail"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/margin_tiny"
		android:adjustViewBounds="true"
		android:contentDescription="@string/connector_message_photo"
		android:maxHeight="240dp"
		android:maxWidth="240dp"
		android:scaleType="fitCenter"
		android:visibility="gone" />

	<LinearLayout
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/margin_tiny"
		android:orientation="horizontal">

		<TextView
			android:id="@+id/connectorMessageDirection"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginEnd="@dimen/margin_small"
			android:textColor="?android:attr/textColorSecondary"
			android:textSize="@dimen/text_size_small" />

		<TextView
			android:id="@+id/connectorMessageDate"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textColor="?android:attr/textColorSecondary"
			android:textSize="@dimen/text_size_small" />

	</LinearLayout>

</LinearLayout>
